# =====================================================================
# STORAGE AUDITOR & SAFE MOVER — .gitignore
# =====================================================================

# ---------------------------------------------------------------------
# 1. Ambientes Virtuais e Gerenciadores de Pacotes Python
# ---------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
*.egg-info/
build/
dist/
wheels/
*.egg

# ---------------------------------------------------------------------
# 2. Caches, Bytecode e Compilação Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

# Caches de ferramentas e testes
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# ---------------------------------------------------------------------
# 3. Relatórios, Logs e Dados Gerados Localmente
# (NUNCA versionar: contêm caminhos reais, índices e metadados locais)
# ---------------------------------------------------------------------
reports/
reports_*/
reports_estrutura_*/
reports_estrutura_C/
reports_estrutura_D/
reports_estrutura_D2/
logs/
*.log
*.log.*
erros*.log
errosC.log
*_SO_FALHAS.jsonl
*_RESUMO.txt

# Planilhas e exportações dinâmicas
*.xlsx
*.xls
*.csv

# ---------------------------------------------------------------------
# 4. Bancos de Dados Locais e Caches Incrementais
# ---------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
storage_auditor_cache.*

# ---------------------------------------------------------------------
# 5. Pastas Locais Privadas e Artefatos Locais
# (Para onde relatórios, inventários e scripts operacionais devem ir)
# ---------------------------------------------------------------------
local_artifacts/
private/
local/
temp/
scratch/

# ---------------------------------------------------------------------
# 6. Assistentes de IA, Agentes e Memórias Locais
# ---------------------------------------------------------------------
.agents/
.gemini/
.antigravity/
.claude/
.cursor/
.aider*
checkpoint-*.md

# ---------------------------------------------------------------------
# 7. IDEs, Editores e Arquivos de Configuração de Workspace
# ---------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ---------------------------------------------------------------------
# 8. Segredos, Chaves e Arquivos de Ambiente
# ---------------------------------------------------------------------
.env
.env.*
*.key
*.pem
*.cert
*.crt

# ---------------------------------------------------------------------
# 9. Arquivos Temporários e do Sistema Operacional
# ---------------------------------------------------------------------
[Dd]esktop.ini
[Tt]humbs.db
ehthumbs.db
$RECYCLE.BIN/
.DS_Store
._*
*.tmp
*.temp
*.bak

# Scripts utilitários de validação local de relatórios
validate_reports.py

# Documentos internos retidos (não publicar por enquanto)
docs/spec_extracted.txt
